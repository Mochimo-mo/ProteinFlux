#!/usr/bin/env python3
"""
Optimized ESM Feature Extraction Script

This script provides high-performance extraction of ESM-2 sequence features and ESM-if structure features
with support for multi-GPU processing, intelligent caching, and memory optimization.

Usage:
    python extract_esm_features_optimized.py --fasta_dir data/fasta --pdb_dir data/pdb --output_dir features/
    python extract_esm_features_optimized.py --mode sequence_only --fasta_dir data/fasta --output_dir features/
"""

import os
