def robust_load_coords(pdb_path: str, chain_id: Optional[str] = None) -> Tuple[np.ndarray, str]:
    """
    Robustly load backbone coordinates (N, CA, C) from a PDB file,
    handling non-standard amino acids by mapping them to standard ones.
    """
    parser = PDBParser(QUIET=True)
    structure = parser.get_structure('protein', pdb_path)
    model = structure[0]
    
    if chain_id:
        if chain_id not in model:
            raise ValueError(f"Chain {chain_id} not found in PDB {pdb_path}")
        chains = [model[chain_id]]
    else:
        chains = list(model.get_chains())
    
    all_coords = []
    all_seq = []
    
    for chain in chains:
        for residue in chain:
            # Skip water and heteroatoms that are not modified amino acids
            if residue.id[0] != ' ' and residue.resname not in NON_STANDARD_SUBSTITUTIONS:
                continue
            
            # Map non-standard to standard
            resname = residue.resname
            if resname in NON_STANDARD_SUBSTITUTIONS:
                resname = NON_STANDARD_SUBSTITUTIONS[resname]
            
            if resname in STANDARD_AMINO_ACIDS:
                one_letter = STANDARD_AMINO_ACIDS[resname]
            else:
                try:
                    one_letter = Polypeptide.three_to_one(resname)
                except (AttributeError, KeyError):
                    continue
            
            # Extract backbone atoms
            res_coords = []
            found_all = True
            for atom_name in ['N', 'CA', 'C']:
                if atom_name in residue:
                    res_coords.append(residue[atom_name].get_coord())
                else:
                    found_all = False
                    break
            
            if found_all:
                all_coords.append(res_coords)
                all_seq.append(one_letter)
                
    if not all_coords:
        raise ValueError(f"No valid residue coordinates found in {pdb_path}")
        
    return np.array(all_coords), "".join(all_seq)

# -----------------------------------------------------------------------------
# Autocast compatibility helper (handles PyTorch >=2.0 new API and older API)
# -----------------------------------------------------------------------------
def autocast_ctx(enabled: bool, device: str):
    """Return an autocast context manager with backward compatibility.

    PyTorch >= 2.0 deprecates torch.cuda.amp.autocast in favor of
    torch.amp.autocast('cuda', ...). We detect availability and fall back
    gracefully for older versions to avoid FutureWarning spam.
    """
    if not enabled or not device.startswith("cuda"):
        return nullcontext()
    # Try new API first
    try:  # PyTorch >= 2.0
        return torch.amp.autocast(device_type='cuda')  # type: ignore[attr-defined]
    except Exception:
        # Fall back to legacy API
        return torch.cuda.amp.autocast()

