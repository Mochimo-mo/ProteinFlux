    'SER': 'S', 'THR': 'T', 'TRP': 'W', 'TYR': 'Y', 'VAL': 'V'
}

# Non-standard to standard amino acid mapping
NON_STANDARD_SUBSTITUTIONS = {
    'PTR': 'TYR', 'SEP': 'SER', 'TPO': 'THR', 'MSE': 'MET',
    'KCX': 'LYS', 'LLP': 'LYS', 'LLY': 'LYS', 'MLY': 'LYS',
